          "type": "string",
          "required": false,
          "label": {
            "en": "Project name, as in Todoist (empty: any)",
            "fr": "Nom du projet, comme dans Todoist (vide : tous)"
          },
          "placeholder": {
            "en": "Home",
            "fr": "Maison"
          }
        },
        {
          "key": "priority",
          "type": "multi_select",
          "required": false,
          "label": {
            "en": "Priorities (none ticked: any)",
            "fr": "Priorités (aucune cochée : toutes)"
          },
          "options": [
            {
              "value": "p1",
              "label": {
                "en": "P1 (urgent, red)",
                "fr": "P1 (urgente, rouge)"
