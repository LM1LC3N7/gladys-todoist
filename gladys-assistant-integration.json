  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Test the account",
        "fr": "Tester le compte"
      },
      "description": {
        "en": "Syncs with Todoist and shows your number of tasks and projects, the tasks due today and overdue, and the time zone of the account.",
        "fr": "Se synchronise avec Todoist et affiche votre nombre de tâches et de projets, les tâches du jour et en retard, et le fuseau horaire du compte."
      }
    }
  ],
  "widgets": [
    {
      "key": "tasks",
      "label": {
        "en": "Todoist tasks",
        "fr": "Tâches Todoist"
      },
      "description": {
        "en": "Today's Todoist tasks (or a project, a filter), to check off or add.",
        "fr": "Les tâches Todoist du jour (ou d'un projet, d'un filtre), à cocher ou ajouter."
      },
      "icon": "check-square",
      "action_timeout_seconds": 30,
      "settings": [
        {
          "key": "filter",
          "type": "string",
          "required": false,
          "label": {
            "en": "Todoist filter (empty: today | overdue)",
            "fr": "Filtre Todoist (vide : today | overdue)"
          },
          "placeholder": {
            "en": "today | overdue",
            "fr": "today | overdue"
          }
        },
        {
          "key": "project",
          "type": "string",
          "required": false,
          "label": {
            "en": "Or a project name (replaces the filter)",
            "fr": "Ou un nom de projet (remplace le filtre)"
          },
          "description": {
            "en": "Shows every task of this project; the \"Add\" form puts new tasks in it.",
            "fr": "Affiche toutes les tâches de ce projet ; le formulaire « Ajouter » y place les nouvelles tâches."
          },
          "placeholder": {
            "en": "Groceries",
            "fr": "Courses"
          }
        }
      ]
    }
  ],
  "scene_triggers": [
